    "about": {
      "id": "about",
      "type": "message",
      "data": {
        "label": "About Us",
        "text": "🏢 *About SK WebTech*\n\nWe're a full-service IT company helping Indian businesses grow online since 2014.\n\n⭐ *10+ years* of experience\n🚀 *80+ projects* delivered\n🤝 *100+ happy clients* across India\n\n*What we do:*\n• Website & Web App Development\n• E-Commerce Stores\n• Mobile Apps (iOS & Android)\n• SEO & Digital Marketing\n• UI/UX Design\n• WhatsApp Business Automation\n• Website Maintenance & Support\n\n🌐 www.skwebtech.in\n💼 Portfolio: www.skwebtech.in/portfolio",
        "buttons": [
          { "id": "btn_about_quote", "text": "📝 Get a Quote" },
          { "id": "btn_about_svc", "text": "🛠 Our Services" },
          { "id": "btn_about_menu", "text": "🏠 Main Menu" }
        ],
        "save_id_as": "about_choice"
      },
      "position": { "x": -1010, "y": 420 },
      "width": 232,
      "height": 210
    },
    "pricing": {
      "id": "pricing",
      "type": "message",
      "data": {
        "label": "Pricing Guide",
        "text": "💰 *Pricing Guide* (typical starting prices)\n\n🌐 Business Website — *₹15,000+*\n💼 Professional Website — *₹30,000–₹80,000*\n🛒 E-Commerce Store — *₹25,000+*\n📱 Mobile App — *₹50,000+*\n🎨 UI/UX Design — *₹20,000+*\n📈 SEO — *₹8,000/month+*\n💬 WhatsApp API Setup — *custom*\n🛡 Website Maintenance — *₹3,000/month+*\n\nEvery project gets a *fixed written quote* before we start — no surprise costs.\n\nWant an exact price for your project?",
        "buttons": [
          { "id": "btn_price_quote", "text": "📝 Get a Quote" },
          { "id": "btn_price_menu", "text": "🏠 Main Menu" }
        ],
        "save_id_as": "pricing_choice"
