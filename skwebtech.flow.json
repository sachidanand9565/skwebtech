    "menu": {
      "id": "menu",
      "type": "list_message",
      "position": { "x": -1330, "y": -200 },
      "data": {
        "label": "Main Menu",
        "body": "👋 *Welcome to SK WebTech!*\n\nWe build websites, e-commerce stores, mobile apps and run SEO & WhatsApp automation for businesses across India.\n\n⭐ 10+ years experience · 80+ projects · 100+ happy clients\n\nTap *View Options* and pick what you'd like to do 👇",
        "button_text": "View Options",
        "sections": [
          {
            "title": "How can we help?",
            "rows": [
              { "title": "Get a Free Quote", "description": "Tell us your project — quote in 24 hrs" },
              { "title": "Our Services", "description": "Details, features & starting prices" },
              { "title": "Pricing Guide", "description": "Typical project costs at a glance" },
              { "title": "About SK WebTech", "description": "Who we are & our work" },
              { "title": "Contact & Support", "description": "Call, email or talk to our team" }
            ]
          }
        ]
      }
    },
    "n-ask-name-1002": {
      "id": "n-ask-name-1002",
      "type": "ask_question",
      "data": {
        "label": "Ask Question",
        "question": "Great! 😊 First, what's your name?",
        "save_as": "user_name",
        "validation": "any"
      },
      "position": { "x": -1010, "y": -230 },
      "width": 224,
      "height": 110
    },
    "n-list-services-1003": {
      "id": "n-list-services-1003",
      "type": "dynamic_list",
      "data": {
        "label": "Dynamic List",
        "url": "https://www.skwebtech.in/api/chatbot/services",
        "method": "POST",
        "headers": "",
        "req_body": "",
        "items_path": "",
        "id_field": "id",
        "title_field": "name",
        "desc_field": "price",
        "body": "Thanks {{var.user_name}}! 🙌\nPlease select the service you're interested in 👇",
        "button_text": "Select Service",
        "save_response_as": "",
        "save_id_as": "service_id",
        "save_title_as": "service_name"
      },
      "position": { "x": -700, "y": -195 },
      "width": 232,
      "height": 151
    },
    "n-ask-requirement-1004": {
      "id": "n-ask-requirement-1004",
      "type": "ask_question",
      "data": {
        "label": "Ask Question",
        "question": "📝 Please describe your project or requirement in a few lines.\n\n(e.g. \"I need an e-commerce website for my clothing brand with payment gateway\")",
        "save_as": "requirement",
        "validation": "any"
      },
      "position": { "x": -400, "y": -190 },
      "width": 224,
      "height": 128
    },
    "n-ask-email-1005": {
      "id": "n-ask-email-1005",
      "type": "ask_question",
      "data": {
        "label": "Ask Question",
        "question": "📧 Your email address? (We'll send the quote here)\n\nType *skip* if you prefer WhatsApp only.",
        "save_as": "email",
        "validation": "any"
      },
      "position": { "x": -120, "y": -190 },
      "width": 224,
      "height": 128
    },
    "n-msg-confirm-1006": {
      "id": "n-msg-confirm-1006",
      "type": "message",
      "data": {
        "label": "Message",
        "text": "Please confirm your request 👇\n\n👤 *Name:* {{var.user_name}}\n📱 *Mobile:* {{contact.phone}}\n🛠 *Service:* {{var.service_name}}\n📝 *Requirement:* {{var.requirement}}\n📧 *Email:* {{var.email}}",
        "buttons": [
          { "id": "btn_confirm", "text": "✅ Confirm Request" },
          { "id": "btn_change", "text": "🔄 Change Service" }
        ],
        "save_id_as": "confirm_choice"
      },
      "position": { "x": 170, "y": -240 },
      "width": 232,
      "height": 191
    },
    "n-api-lead-1007": {
      "id": "n-api-lead-1007",
      "type": "api",
      "data": {
        "label": "API Request",
        "method": "POST",
        "url": "https://www.skwebtech.in/api/chatbot/lead",
        "body": "{\n  \"name\": \"{{var.user_name}}\",\n  \"mobile\": \"{{contact.phone}}\",\n  \"service\": \"{{var.service_id}}\",\n  \"service_name\": \"{{var.service_name}}\",\n  \"requirement\": \"{{var.requirement}}\",\n  \"email\": \"{{var.email}}\",\n  \"source\": \"WhatsApp Bot\"\n}",
        "save_as": "",
        "extract_fields": [
          { "path": "lead_id", "variable": "lead_id" }
        ]
      },
      "position": { "x": 470, "y": -190 },
      "width": 224,
      "height": 90
    },
    "n-msg-success-1008": {
      "id": "n-msg-success-1008",
      "type": "message",
      "data": {
        "label": "Message",
        "text": "✅ *Request Received!*\n\nDear {{var.user_name}},\n\nThank you for choosing *SK WebTech*! 🙏\n\n📋 *Your Request:*\n• Service: {{var.service_name}}\n• Mobile: {{contact.phone}}\n• Reference ID: {{var.lead_id}}\n\nOur team will contact you within *24 hours* with a free consultation & detailed quote.\n\n📞 Urgent? Call: +91 9654603750\n🌐 www.skwebtech.in",
        "buttons": []
      },
      "position": { "x": 760, "y": -210 },
      "width": 232,
      "height": 125
    },
